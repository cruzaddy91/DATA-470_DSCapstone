{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Model (Memory Safe)",
      "type": "shell",
      "command": "make",
      "args": [
        "run",
        "SCRIPT=${input:scriptPath}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Start Memory Monitor",
      "type": "shell",
      "command": "make",
      "args": [
        "monitor",
        "TARGET=${input:monitorTarget}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "scriptPath",
      "type": "promptString",
      "description": "Python script path to run through the memory-safe wrapper",
      "default": "scripts/run_modeling.py"
    },
    {
      "id": "monitorTarget",
      "type": "promptString",
      "description": "PID or process-name pattern for memguard to watch",
      "default": "scripts/run_modeling.py"
    }
  ]
}
