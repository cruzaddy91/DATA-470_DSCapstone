%% Governed table / DDL change path (analogous to stg → edw → rpt layering in PROD docs)
%% Not capstone-data-specific — reusable flow for “actual table changes”

flowchart TB
  subgraph D["Design"]
    R[Change need<br/>column / table / view]
    A[Author DDL + docs<br/>in version control]
  end

  subgraph I["Implement — non-PROD"]
    RV[Code review]
    DV[Deploy to DEV<br/>pool / warehouse]
  end

  subgraph Q["Quality gate"]
    CK[Validation<br/>counts · deps · pipelines]
    AP[Approval for PROD]
  end

  subgraph P["PROD"]
    EX[Execute DDL / deploy<br/>in change window]
    SM[Smoke tests & monitors]
  end

  R --> A
  A --> RV
  RV --> DV
  DV --> CK
  CK --> AP
  AP --> EX
  EX --> SM

  %% Westminster brand (see westminster_poster_palette.py)
  classDef pipeline fill:#F5EBE0,stroke:#9D581F,color:#101820
  classDef process fill:#EDE5F7,stroke:#9063CD,color:#101820
  classDef reporting fill:#E8E4EF,stroke:#211551,color:#101820

  class R,A pipeline
  class RV,DV,CK,AP process
  class EX pipeline
  class SM reporting
