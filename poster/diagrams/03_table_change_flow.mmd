%% Governed table / DDL change path (Westminster brand)
%%{init: {'theme': 'base', 'flowchart': {'htmlLabels': true}}}%%

flowchart TB
  subgraph D["Design"]
    R[Change need<br/>column / table / view]
    A[Author DDL + docs<br/>in version control]
  end

  subgraph I["Implement — non-PROD"]
    RV[Code review]
    DV[Deploy to DEV<br/>pool / warehouse]
  end

  subgraph Q["Quality gate"]
    CK[Validation<br/>counts · deps · pipelines]
    AP[Approval for PROD]
  end

  subgraph P["PROD"]
    EX[Execute DDL / deploy<br/>in change window]
    SM[Smoke tests & monitors]
  end

  R --> A
  A --> RV
  RV --> DV
  DV --> CK
  CK --> AP
  AP --> EX
  EX --> SM

  classDef pipeline fill:#FFFFFF,stroke:#9D581F,color:#101820
  classDef process fill:#F1F1DE,stroke:#211551,color:#101820
  classDef reporting fill:#EDE5F7,stroke:#8252C7,color:#101820

  class R,A pipeline
  class RV,DV,CK,AP process
  class EX pipeline
  class SM reporting
