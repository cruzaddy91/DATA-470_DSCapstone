%% Capstone poster — panel 2 (Westminster brand)
%% Honest selection-process flow: Inner temporal CV selects Stack by rule;
%% outer temporal holdout shows Logistic Regression is the deployable best.
%%{init: {'theme': 'base', 'flowchart': {'htmlLabels': true}}}%%

flowchart TB
  DATA["Training data<br/>order–time features<br/>31k+ rows · 3.4% pos."]

  subgraph INNER["Inner temporal validation · SELECT HERE"]
    direction TB
    LR["Logistic Regression<br/><i>linear</i>"]
    LGBM["LightGBM<br/><i>boosted tree</i>"]
    RF["RandomForest<br/><i>bagged tree</i>"]
    KNN["kNN<br/><i>instance–based</i>"]
    STACK["Stack · OOF–calibrated<br/><i>LR + LightGBM + RF + kNN</i>"]
    RANK{{"Rank by PR–AUC<br/>(temporal folds)"}}
    LR --> RANK
    LGBM --> RANK
    RF --> RANK
    KNN --> RANK
    STACK --> RANK
  end

  GATE{{"Deploy gate<br/>precision floor 0.15<br/>recall floor 0.35"}}
  HOLDOUT["Outer temporal holdout · REPORT ONCE<br/>LR: ROC 0.910 · PR 0.358 · F1 0.511<br/>Stack: ROC 0.936 · PR 0.326 · F1 0.420"]
  MATURITY{{"Label maturity gate<br/>last 180 days:<br/>36% coverage, 32 positives<br/>FAILS (dataset, not model)"}}

  DATA --> INNER
  RANK -->|"rule–selected: Stack<br/>deployable best: LR"| GATE
  GATE -->|"model gates PASS"| HOLDOUT
  HOLDOUT --> MATURITY

